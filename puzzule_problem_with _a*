import heapq

class PuzzleState:
    def __init__(self, board, parent=None, move=None, depth=0):
        self.board = board
        self.parent = parent
        self.move = move
        self.depth = depth
        self.zero_index = self.board.index(0)

    def __eq__(self, other):
        return self.board == other.board

    def __lt__(self, other):
        return (self.depth + self.manhattan()) < (other.depth + other.manhattan())

    def manhattan(self):
        """Heuristic: Manhattan distance"""
        distance = 0
        for i, tile in enumerate(self.board):
            if tile != 0:
                goal_x, goal_y = divmod(tile - 1, 3)
                cur_x, cur_y = divmod(i, 3)
                distance += abs(goal_x - cur_x) + abs(goal_y - cur_y)
        return distance

    def is_goal(self):
        return self.board == [1,2,3,4,5,6,7,8,0]

    def successors(self):
        """Generate possible moves"""
        successors = []
        x, y = divmod(self.zero_index, 3)
        moves = {
            "Up": (x-1, y),
            "Down": (x+1, y),
            "Left": (x, y-1),
            "Right": (x, y+1)
        }
        for move, (nx, ny) in moves.items():
            if 0 <= nx < 3 and 0 <= ny < 3:
                new_index = nx*3 + ny
                new_board = self.board[:]
                new_board[self.zero_index], new_board[new_index] = new_board[new_index], new_board[self.zero_index]
                successors.append(PuzzleState(new_board, self, move, self.depth+1))
        return successors

    def display(self):
        for i in range(0, 9, 3):
            print(self.board[i:i+3])
        print()

def astar(initial_state):
    frontier = []
    heapq.heappush(frontier, (initial_state.depth + initial_state.manhattan(), initial_state))
    explored = set()

    while frontier:
        _, state = heapq.heappop(frontier)

        if tuple(state.board) in explored:
            continue
        explored.add(tuple(state.board))

        state.display()

        if state.is_goal():
            return state

        for succ in state.successors():
            if tuple(succ.board) not in explored:
                heapq.heappush(frontier, (succ.depth + succ.manhattan(), succ))
    return None

def reconstruct_path(goal_state):
    path = []
    current = goal_state
    while current.parent is not None:
        path.append(current.move)
        current = current.parent
    return path[::-1]

def main():
    # Example initial state
    initial_board = [1,2,3,4,0,6,7,5,8]
    initial_state = PuzzleState(initial_board)

    print("Initial State:")
    initial_state.display()

    goal_state = astar(initial_state)

    if goal_state:
        print("Goal State Reached!")
        goal_state.display()
        moves = reconstruct_path(goal_state)
        print("Sequence of Moves:")
        for i, move in enumerate(moves, 1):
            print(f"Move {i}: {move}")
    else:
        print("No solution found.")

if __name__ == "__main__":
    main()
